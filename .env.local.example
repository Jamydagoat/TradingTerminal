
# Market data
FINNHUB_API_KEY=

# AI daily rundown
GEMINI_API_KEY=
# Optional — override if the default Gemini model id is retired.
GEMINI_MODEL=

# Google sign-in. Leave all three blank to run without auth (local dev).
# Setting only some of them fails closed rather than leaving the app open.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Any long random string — signs the session cookie.
AUTH_SECRET=
# Comma separated. Exact addresses, or @domain.com for a whole domain.
# An empty list allows nobody.
AUTH_ALLOWED_EMAILS=
